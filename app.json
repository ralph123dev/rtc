{
  "expo": {
    "name": "rtc",
    "slug": "rtc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/img/logo.png",
    "scheme": "rtc",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/42c7dd3b-92a2-41f9-baad-9e077b6c5421"
    },
    "ios": {
      "icon": "./assets/images/img/logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/img/logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/img/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.urgue.rtc"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/img/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "42c7dd3b-92a2-41f9-baad-9e077b6c5421"
      }
    }
  }
}
