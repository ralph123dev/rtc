# Reduces the archive sent to EAS Build and speeds up fingerprint calculation.

# Dependencies and Expo-generated files
node_modules/
.expo/
.expo-shared/
expo-env.d.ts
dist/
build/
web-build/

# Native projects are generated by EAS
android/
ios/
.kotlin/

# Version control and editor settings
.git/
.vscode/
.idea/

# Logs and debug output
*.log
npm-debug.*
yarn-debug.*
yarn-error.log
.metro-health-check*

# OS and local development files
.DS_Store
.env*.local
*.tsbuildinfo

# Signing credentials and certificates
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# Temporary and generated files
*.orig.*
coverage/

# Tests
__tests__/
*.test.js
*.spec.js

# This file
.easignore
